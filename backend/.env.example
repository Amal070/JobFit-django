# =====================================================================
# JobFit AI — Backend Environment Variables (.env)
# =====================================================================

# ---------------------------------------------------------------------
# Django Core Settings
# ---------------------------------------------------------------------
# In production, set a strong random secret key (e.g., using `python -c "import secrets; print(secrets.token_urlsafe(50))"`)
SECRET_KEY=your-super-secret-django-production-key

# Set to False in production
DEBUG=False

# Comma-separated allowed hostnames or IP addresses.
# For Render, add your web service domain: your-backend.onrender.com,.onrender.com
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# ---------------------------------------------------------------------
# Database Configuration (PostgreSQL in production)
# ---------------------------------------------------------------------
# Provided automatically by Render PostgreSQL via connectionString
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Leave blank to fall back to SQLite for local development.
DATABASE_URL=

# ---------------------------------------------------------------------
# CORS & CSRF Settings
# ---------------------------------------------------------------------
# In production, set to False and specify exact origins
CORS_ALLOW_ALL_ORIGINS=False

# Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173

# Comma-separated list of trusted origins for CSRF protection
CSRF_TRUSTED_ORIGINS=https://your-frontend.onrender.com,https://your-backend.onrender.com,https://*.onrender.com

# ---------------------------------------------------------------------
# AI Service Credentials
# ---------------------------------------------------------------------
# Groq API key is required for ATS resume analysis (obtain free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional alternative AI provider key
ANTHROPIC_API_KEY=
