# =====================================================================
# JobFit AI — Root Environment Variables Overview
# =====================================================================
# For detailed examples, see:
# - backend/.env.example
# - frontend/.env.example

# --- Backend Settings ---
SECRET_KEY=your-super-secret-django-production-key
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
DATABASE_URL=postgresql://user:pass@host:5432/dbname
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://jobfit-frontend.onrender.com
CSRF_TRUSTED_ORIGINS=https://jobfit-frontend.onrender.com,https://*.onrender.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Frontend Settings ---
VITE_API_BASE_URL=https://jobfit-backend.onrender.com/api
