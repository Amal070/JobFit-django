# =====================================================================
# JobFit-AI Root .gitignore
# =====================================================================

# ---------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL - NEVER COMMIT)
# ---------------------------------------------------------------------
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example

# ---------------------------------------------------------------------
# Database & Media / Uploads (Private User Data)
# ---------------------------------------------------------------------
*.sqlite3
*.db
db.sqlite3
**/db.sqlite3
media/
**/media/
**/media/resumes/
**/media/resumes/pdfs/*
!**/media/resumes/pdfs/.gitkeep

# ---------------------------------------------------------------------
# Python & Backend Artifacts
# ---------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# Pip / egg build directories
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Whitelist frontend/lib source code
!frontend/lib/
!frontend/lib/**

# Virtual Environments
venv/
**/venv/
.venv/
**/.venv/
env/
**/env/
ENV/
env.bak/
venv.bak/

# ---------------------------------------------------------------------
# Node & Frontend Artifacts
# ---------------------------------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend Builds & Cache
.react-router/
**/.react-router/
.vite/
**/.vite/
frontend/build/
**/build/
frontend/dist/
**/dist/

# ---------------------------------------------------------------------
# Editors, IDEs & OS Files
# ---------------------------------------------------------------------
.idea/
**/.idea/
.vscode/
**/.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ---------------------------------------------------------------------
# Logs & Temporary Files
# ---------------------------------------------------------------------
*.log
logs/
**/logs/
tmp/
temp/
